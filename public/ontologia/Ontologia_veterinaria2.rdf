        <vet1:descripcionEnfermedad>Infección secundaria de la piel por rascado</vet1:descripcionEnfermedad>
        <vet1:nivelGravedad>Moderado</vet1:nivelGravedad>
        <vet1:nombreEnfermedad>Dermatitis Bacteriana</vet1:nombreEnfermedad>
        <vet1:sintomas>Pústulas, costras y pérdida de pelo</vet1:sintomas>
        <vet1:tipoEnfermedad>Cutánea</vet1:tipoEnfermedad>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_08 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_08">
        <rdf:type rdf:resource="vet:Enfermedad"/>
        <vet1:afectaA rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Animal_07"/>
        <vet1:descripcionEnfermedad>Enfermedad infecciosa viral que debilita el sistema inmune</vet1:descripcionEnfermedad>
        <vet1:nivelGravedad>Grave</vet1:nivelGravedad>
        <vet1:nombreEnfermedad>Leucemia Felina</vet1:nombreEnfermedad>
        <vet1:sintomas>Fiebre, letargia y pérdida de peso</vet1:sintomas>
        <vet1:tipoEnfermedad>Viral</vet1:tipoEnfermedad>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_09 -->

