    <!-- http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_06 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_06">
        <rdf:type rdf:resource="vet:Enfermedad"/>
        <vet1:afectaA rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Animal_03"/>
        <vet1:descripcionEnfermedad>Infección recurrente y severa en ambos oídos</vet1:descripcionEnfermedad>
        <vet1:nivelGravedad>Moderado</vet1:nivelGravedad>
        <vet1:nombreEnfermedad>Otitis Cronica</vet1:nombreEnfermedad>
        <vet1:sintomas>Mal olor, dolor severo y engrosamiento del canal</vet1:sintomas>
        <vet1:tipoEnfermedad>Infecciosa</vet1:tipoEnfermedad>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_07 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_07">
