    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- vet:Animal -->

    <owl:Class rdf:about="vet:Animal">
        <rdfs:comment>Animal doméstico atendido en la clínica veterinaria (perro, gato, pez, conejo, tortuga, ave).</rdfs:comment>
        <rdfs:label>Animal</rdfs:label>
    </owl:Class>
    


    <!-- vet:Cirugia -->

    <owl:Class rdf:about="vet:Cirugia">
        <rdfs:subClassOf rdf:resource="vet:ServicioClinico"/>
        <rdfs:comment>Intervención quirúrgica realizada al animal.</rdfs:comment>
        <rdfs:label>Cirugia</rdfs:label>
    </owl:Class>
    


    <!-- vet:Consulta -->

    <owl:Class rdf:about="vet:Consulta">
        <rdfs:subClassOf rdf:resource="vet:ServicioClinico"/>
        <rdfs:comment>Consulta médica veterinaria.</rdfs:comment>
        <rdfs:label>Consulta</rdfs:label>
    </owl:Class>
    


    <!-- vet:Dueno -->

    <owl:Class rdf:about="vet:Dueno">
        <rdfs:subClassOf rdf:resource="vet:Persona"/>
        <owl:disjointWith rdf:resource="vet:Veterinario"/>
        <rdfs:comment>Propietario de una o más mascotas.</rdfs:comment>
        <rdfs:label>Dueño</rdfs:label>
    </owl:Class>
    


    <!-- vet:Enfermedad -->

    <owl:Class rdf:about="vet:Enfermedad">
        <rdfs:comment>Enfermedad o condición médica que puede afectar a un animal.</rdfs:comment>
        <rdfs:label>Enfermedad</rdfs:label>
    </owl:Class>
    


    <!-- vet:ExamenMedico -->

    <owl:Class rdf:about="vet:ExamenMedico">
        <rdfs:subClassOf rdf:resource="vet:ServicioClinico"/>
        <rdfs:comment>Examen médico realizado al animal.</rdfs:comment>
        <rdfs:label>ExamenMedico</rdfs:label>
    </owl:Class>
    


    <!-- vet:Medicamento -->

    <owl:Class rdf:about="vet:Medicamento">
        <rdfs:comment>Medicamento utilizado en el tratamiento de enfermedades animales.</rdfs:comment>
        <rdfs:label>Medicamento</rdfs:label>
    </owl:Class>
    


    <!-- vet:Persona -->

    <owl:Class rdf:about="vet:Persona">
        <rdfs:comment>Persona relacionada con la atención veterinaria.</rdfs:comment>
        <rdfs:label>Persona</rdfs:label>
    </owl:Class>
    


    <!-- vet:ServicioClinico -->

    <owl:Class rdf:about="vet:ServicioClinico">
        <rdfs:comment>Servicio médico ofrecido en la clínica veterinaria.</rdfs:comment>
        <rdfs:label>ServicioClinico</rdfs:label>
    </owl:Class>
    


    <!-- vet:Tratamiento -->

    <owl:Class rdf:about="vet:Tratamiento">
        <rdfs:subClassOf rdf:resource="vet:ServicioClinico"/>
        <rdfs:comment>Tratamiento médico aplicado al animal.</rdfs:comment>
        <rdfs:label>Tratamiento</rdfs:label>
    </owl:Class>
    


    <!-- vet:Vacunacion -->

    <owl:Class rdf:about="vet:Vacunacion">
        <rdfs:subClassOf rdf:resource="vet:ServicioClinico"/>
        <rdfs:comment>Servicio de aplicación de vacunas a animales.</rdfs:comment>
        <rdfs:label>Vacunacion</rdfs:label>
    </owl:Class>
    


    <!-- vet:Veterinario -->

    <owl:Class rdf:about="vet:Veterinario">
        <rdfs:subClassOf rdf:resource="vet:Persona"/>
        <rdfs:comment>Profesional veterinario que atiende animales.</rdfs:comment>
        <rdfs:label>Veterinario</rdfs:label>
    </owl:Class>
    


    <!-- xsd:string -->

    <owl:Class rdf:about="xsd:string"/>
    


