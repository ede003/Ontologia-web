    <vet:afectaA rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Animal_21"/>
    <vet:sintomas xml:lang="es">Fiebre alta, dificultad respiratoria, diarrea verde</vet:sintomas>
    <vet:sintomas xml:lang="en">High fever, respiratory difficulty, green diarrhea</vet:sintomas>
    <vet:sintomas xml:lang="pt">Febre alta, dificuldade respiratória, diarreia verde</vet:sintomas>
    <vet:nivelGravedad xml:lang="es">Grave</vet:nivelGravedad>
    <vet:nivelGravedad xml:lang="en">Severe</vet:nivelGravedad>
    <vet:nivelGravedad xml:lang="pt">Grave</vet:nivelGravedad>
