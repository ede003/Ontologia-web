  <rdf:Description rdf:about="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_05">
    <vet:diagnosticadaPor rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Veterinario_03"/>
    <vet:afectaA rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Animal_06"/>
