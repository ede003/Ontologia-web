  <rdf:Description rdf:about="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Enfermedad_14">
    <vet:diagnosticadaPor rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Veterinario_01"/>
    <vet:afectaA rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Animal_17"/>
    <vet:sintomas xml:lang="es">Tos seca persistente, estornudos, secrecion nasal</vet:sintomas>
    <vet:sintomas xml:lang="en">Persistent dry cough, sneezing, nasal discharge</vet:sintomas>
    <vet:sintomas xml:lang="pt">Tosse seca persistente, espirros, secreção nasal</vet:sintomas>
    <vet:nivelGravedad xml:lang="es">Leve</vet:nivelGravedad>
    <vet:nivelGravedad xml:lang="en">Mild</vet:nivelGravedad>
    <vet:nivelGravedad xml:lang="pt">Leve</vet:nivelGravedad>
    <vet:descripcionEnfermedad xml:lang="es">Infeccion del tracto respiratorio superior, conocida como tos de perrera.</vet:descripcionEnfermedad>
    <vet:descripcionEnfermedad xml:lang="en">Upper respiratory tract infection, known as kennel cough.</vet:descripcionEnfermedad>
    <vet:descripcionEnfermedad xml:lang="pt">Infecção do trato respiratório superior, conhecida como tosse dos canis.</vet:descripcionEnfermedad>
    <vet:tipoEnfermedad xml:lang="es">Bacteriana</vet:tipoEnfermedad>
    <vet:tipoEnfermedad xml:lang="en">Bacterial</vet:tipoEnfermedad>
    <vet:tipoEnfermedad xml:lang="pt">Bacteriana</vet:tipoEnfermedad>
    <vet:nombreEnfermedad xml:lang="es">Traqueobronquitis Canina</vet:nombreEnfermedad>
    <vet:nombreEnfermedad xml:lang="en">Canine Tracheobronchitis</vet:nombreEnfermedad>
    <vet:nombreEnfermedad xml:lang="pt">Traqueobronquite Canina</vet:nombreEnfermedad>
