    <vet:descripcionEnfermedad xml:lang="en">Highly contagious viral disease in birds.</vet:descripcionEnfermedad>
    <vet:descripcionEnfermedad xml:lang="pt">Doença viral altamente contagiosa em aves.</vet:descripcionEnfermedad>
    <vet:tipoEnfermedad xml:lang="es">Viral</vet:tipoEnfermedad>
    <vet:tipoEnfermedad xml:lang="en">Viral</vet:tipoEnfermedad>
    <vet:tipoEnfermedad xml:lang="pt">Viral</vet:tipoEnfermedad>
