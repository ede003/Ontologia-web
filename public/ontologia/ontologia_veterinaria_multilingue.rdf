  <rdf:Description rdf:about="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Tratamiento_20">
    <vet:indicaciones xml:lang="es">Ribavirin oral cada 12 horas por 10 dias con soporte</vet:indicaciones>
    <vet:indicaciones xml:lang="en">Ribavirin orally every 12 hours for 10 days with supportive care</vet:indicaciones>
    <vet:indicaciones xml:lang="pt">Ribavirina oral a cada 12 horas por 10 dias com suporte</vet:indicaciones>
    <vet:duracion rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</vet:duracion>
    <vet:tipoTratamiento xml:lang="es">Antiviral</vet:tipoTratamiento>
    <vet:tipoTratamiento xml:lang="en">Antiviral</vet:tipoTratamiento>
    <vet:tipoTratamiento xml:lang="pt">Antiviral</vet:tipoTratamiento>
    <vet:usa rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Medicamento_20"/>
    <vet:realizadoA rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Animal_21"/>
    <vet:realizadoPor rdf:resource="http://www.semanticweb.org/grupo14/ontologias/veterinaria#Veterinario_19"/>
